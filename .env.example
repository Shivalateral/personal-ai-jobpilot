# ==============================================================================
# Personal AI JobPilot - Environment Configuration
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env or real credentials to version control.
# ==============================================================================

# --- Application (Local Windows defaults) ---
APP_NAME=Personal AI JobPilot
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_API_URL=http://127.0.0.1:8000

# --- Security & Privacy ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty in development, a local key file is generated in ./data/.fernet.key (gitignored).
RESUME_ENCRYPTION_KEY=
# Optional shared secret for protecting API / Cloud Scheduler webhook calls
API_AUTH_TOKEN=
SCHEDULER_AUTH_TOKEN=

# --- Database (PostgreSQL primary; SQLite fallback for local development) ---
# Production / Docker PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://jobpilot:jobpilot@localhost:5432/jobpilot
DATABASE_URL=sqlite:///./data/jobpilot.db

# --- Vector Database & Embeddings ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_JOBS=jobpilot_jobs
CHROMA_COLLECTION_RESUMES=jobpilot_resumes
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Set true in fully air-gapped environments to avoid HuggingFace Hub network calls
EMBEDDING_OFFLINE_FALLBACK=false

# --- LLM Configuration (OpenAI-compatible: OpenAI GPT, Ollama Qwen/Llama, Groq, vLLM) ---
# Provider examples:
#   OpenAI: LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-4o-mini, LLM_API_KEY=sk-...
#   Ollama (local Qwen/Llama): LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=qwen2.5:7b, LLM_API_KEY=ollama
#   Groq (Llama): LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=llama-3.1-8b-instant, LLM_API_KEY=gsk_...
LLM_PROVIDER=gemini_openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# Optional OpenAI/ChatGPT secondary fallback (only used if primary Gemini quota fails)
LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_FALLBACK_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# --- Autonomous Job Discovery ---
DISCOVERY_USER_AGENT=PersonalAIJobPilot/1.0 (+https://github.com/personal-ai-jobpilot; respectful-ats-client)
DISCOVERY_REQUEST_TIMEOUT=12
DISCOVERY_RATE_LIMIT_SECONDS=0.35
DISCOVERY_MIN_MATCH_NOTIFY=70.0
PREFERRED_LOCATIONS=Hyderabad,Bangalore,Bengaluru,Chennai,India,Remote
# Comma-separated Greenhouse board tokens (official public API)
GREENHOUSE_BOARDS=databricks,scaleai,anthropic,druva,mongodb,stripe,gitlab,elastic,airbnb,coinbase,datadog,groww,twilio,figma,cloudflare,discord,canonical,reddit,roblox,pinterest,coursera,duolingo,spacex,zscaler,rubrik,fivetran,okta,waymo,toast,samsara,brex,adyen,affirm,lyft,grafanalabs,epicgames,klaviyo,nuro,instacart,vercel,chime,inmobi,geotab,monzo,dropbox,mixpanel,launchdarkly,n26,slice,wise,hootsuite,cockroachlabs,airtable,netlify,purestorage,celonis,deliveroo,contentful,pine
# Comma-separated Lever company slugs (official public API)
LEVER_COMPANIES=paytm,meesho,cred,spotify,binance,palantir
# Comma-separated Ashby company slugs (official public API)
ASHBY_COMPANIES=sarvam,perplexity,ramp,linear,cohere,openai,elevenlabs,langchain,modal,replit,notion,vercel,supabase,1password,wealthsimple,float,koho,vanta,drata,benevity,oyster,lightspeed,harvey,cognition,baseten,mercor,fireworks,cursor,suno,writer,livekit,anyscale,pika,midjourney,resend,posthog,vapi,poolside,runway,neon,deliveroo
# Comma-separated SmartRecruiters company identifiers (official public API, India/Canada/Global)
SMARTRECRUITERS_COMPANIES=BoschGroup,NielsenIQ,AbbVie,Visa,SAP,ServiceNow,Wipro,PublicisGroupe,Siemens,Continental,Sodexo,Uber
WORKDAY_ENDPOINTS=
# Enable public authorized APIs / RSS feeds
ENABLE_REMOTIVE_API=true
ENABLE_ARBEITNOW_API=true
ENABLE_JOBICY_API=true
ENABLE_HIMALAYAS_API=true
ENABLE_REMOTEOK_API=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
RSS_FEED_URLS=https://weworkremotely.com/remote-jobs.rss,https://weworkremotely.com/categories/remote-programming-jobs.rss,https://weworkremotely.com/categories/remote-full-stack-programming-jobs.rss,https://weworkremotely.com/categories/remote-back-end-programming-jobs.rss,https://weworkremotely.com/categories/remote-front-end-programming-jobs.rss
CAREER_PAGE_URLS=

# --- Daily Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_CRON_HOUR=8
SCHEDULER_CRON_MINUTE=30
SCHEDULER_TIMEZONE=Asia/Kolkata

# --- Notifications (in-app + optional Webhook) ---
NOTIFICATION_WEBHOOK_URL=
